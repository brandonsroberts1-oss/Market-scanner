# ---------------------------------------------------------------------------
# Market Scanner configuration. Copy to `.env` and edit. All values optional.
# ---------------------------------------------------------------------------

# Which market-data provider to use.
#   auto    - (default) Tradier if a token is set, else Yahoo, else demo
#   tradier - real-time quotes + option greeks (needs TRADIER_TOKEN)
#   yahoo   - free, no key, ~15-min delayed options / near-real-time equities
#   demo    - fully offline deterministic simulator (no network needed)
MARKET_DATA_PROVIDER=auto

# Tradier: free developer token at https://developer.tradier.com/
# Sandbox tokens work but return delayed data; a funded brokerage account
# token returns true real-time quotes and greeks.
TRADIER_TOKEN=
TRADIER_BASE_URL=https://api.tradier.com/v1

# Server
HOST=127.0.0.1
PORT=8000

# SQLite location
DB_PATH=data/market_scanner.db

# Comma-separated extra tickers to always include in the scan universe
EXTRA_UNIVERSE=
